class ScepError(Exception):
    """Anything that should be reported to the user as a plain message."""


# ---------------------------------------------------------------------------
# DER encoding
# ---------------------------------------------------------------------------

TAG_INT = 0x02
TAG_OCTETSTRING = 0x04
TAG_OID = 0x06
TAG_PRINTABLESTRING = 0x13
TAG_SEQUENCE = 0x30
TAG_SET = 0x31


def enc_len(n):
    if n < 0x80:
        return bytes([n])
    b = n.to_bytes((n.bit_length() + 7) // 8, "big")
    return bytes([0x80 | len(b)]) + b


def tlv(tag, body):
    return bytes([tag]) + enc_len(len(body)) + body


def der_int(n):
    """DER INTEGER for a non-negative integer."""
    if n == 0:
        return tlv(TAG_INT, b"\x00")
    return tlv(TAG_INT, n.to_bytes((n.bit_length() // 8) + 1, "big"))


def der_oid(dotted):
    parts = [int(x) for x in dotted.split(".")]
    out = bytearray([parts[0] * 40 + parts[1]])
    for value in parts[2:]:
        chunk = [value & 0x7F]
        value >>= 7
        while value:
            chunk.append((value & 0x7F) | 0x80)
            value >>= 7
        out.extend(reversed(chunk))
    return tlv(TAG_OID, bytes(out))


def der_seq(*items):
    return tlv(TAG_SEQUENCE, b"".join(items))


def der_set(*items):
    return tlv(TAG_SET, b"".join(items))


def der_octets(data):
    return tlv(TAG_OCTETSTRING, data)


def der_printable(text):
    return tlv(TAG_PRINTABLESTRING, text.encode("ascii"))


def der_tagged(num, body):
    """Context-specific constructed [num].

    CMS uses this for both EXPLICIT wrappers (eContent) and IMPLICIT ones
    (certificates, signedAttrs); the encoding is the same either way.
    """
    return tlv(0xA0 | num, body)


def algid(oid):
    """AlgorithmIdentifier with an explicit NULL parameter."""
    return der_seq(der_oid(oid), b"\x05\x00")


# ---------------------------------------------------------------------------
# DER parsing
# ---------------------------------------------------------------------------


class Node:
    """One parsed TLV. `raw` is the whole element, `body` its contents."""

    __slots__ = ("tag", "body", "raw")

    def __init__(self, tag, body, raw):
        self.tag = tag
        self.body = body
        self.raw = raw

    def children(self):
        nodes = []
        offset = 0
        while offset < len(self.body):
            node, offset = parse_one(self.body, offset)
            nodes.append(node)
        return nodes


def parse_one(data, offset=0):
    """Parse a single TLV at `offset`; returns (Node, next_offset)."""
    start = offset
    if offset + 2 > len(data):
        raise ValueError("truncated DER")
    tag = data[offset]
    offset += 1
    length = data[offset]
    offset += 1
    if length & 0x80:
        count = length & 0x7F
        if count == 0:
            raise ValueError("indefinite-length DER is not supported")
        length = int.from_bytes(data[offset : offset + count], "big")
        offset += count
    end = offset + length
    if end > len(data):
        raise ValueError("truncated DER: declared length overruns buffer")
    return Node(tag, data[offset:end], data[start:end]), end


def read_int(node):
    return int.from_bytes(node.body, "big")


def read_oid(node):
    body = node.body
    parts = [body[0] // 40, body[0] % 40]
    value = 0
    for byte in body[1:]:
        value = (value << 7) | (byte & 0x7F)
        if not byte & 0x80:
            parts.append(value)
            value = 0
    return ".".join(str(p) for p in parts)


# ---------------------------------------------------------------------------
# Object identifiers
# ---------------------------------------------------------------------------

OID_RSA = "1.2.840.113549.1.1.1"
OID_SHA512 = "2.16.840.1.101.3.4.2.3"
OID_SHA256 = "2.16.840.1.101.3.4.2.1"

OID_PKCS7_DATA = "1.2.840.113549.1.7.1"
OID_PKCS7_SIGNED = "1.2.840.113549.1.7.2"

OID_CONTENT_TYPE = "1.2.840.113549.1.9.3"
OID_MESSAGE_DIGEST = "1.2.840.113549.1.9.4"

# SCEP attributes (RFC 8894, on Verisign's historical arc)
OID_SCEP_MESSAGE_TYPE = "2.16.840.1.113733.1.9.2"
OID_SCEP_PKI_STATUS = "2.16.840.1.113733.1.9.3"
OID_SCEP_FAIL_INFO = "2.16.840.1.113733.1.9.4"
OID_SCEP_SENDER_NONCE = "2.16.840.1.113733.1.9.5"
OID_SCEP_RECIPIENT_NONCE = "2.16.840.1.113733.1.9.6"
OID_SCEP_TRANS_ID = "2.16.840.1.113733.1.9.7"

DIGEST_OIDS = {"sha512": OID_SHA512, "sha256": OID_SHA256}

FAIL_INFO = {
    "0": "badAlg: unrecognised or unsupported algorithm",
    "1": "badMessageCheck: integrity check failed",
    "2": "badRequest: transaction not permitted or supported",
    "3": "badTime: message time was not close enough to the server's clock",
    "4": "badCertId: no certificate matched the request",
}


# ---------------------------------------------------------------------------
# openssl
# ---------------------------------------------------------------------------


class OpenSSL:
    """Thin wrapper over the openssl CLI, scoped to a private temp directory."""

    def __init__(self, workdir):
        self.exe = shutil.which("openssl")
        if not self.exe:
            raise ScepError(
                "the 'openssl' command was not found. Install it with your "
                "package manager (e.g. apt install openssl, dnf install openssl)."
            )
        self.workdir = workdir
        self.major = self._version_major()

    def _version_major(self):
        result = subprocess.run([self.exe, "version"], capture_output=True, text=True)
        try:
            return int(result.stdout.split()[1].split(".")[0])
        except (IndexError, ValueError):
            return 3

    def path(self, name):
        return os.path.join(self.workdir, name)

    def run(self, args, stdin=None, legacy=False, binary=True):
        """Run openssl; raise ScepError carrying stderr on failure."""
        args = list(args)
        if legacy and self.major >= 3:
            # Single DES moved to the legacy provider in OpenSSL 3, and Mist's
            # CA encrypts its replies with DES-CBC. These have to go before any
            # positional arguments, so insert them right after the subcommand.
            args[1:1] = ["-provider", "legacy", "-provider", "default"]
        cmd = [self.exe] + args
        result = subprocess.run(cmd, input=stdin, capture_output=True)
        if result.returncode != 0:
            raise ScepError(
                "openssl %s failed:\n%s"
                % (args[0], result.stderr.decode("utf-8", "replace").strip())
            )
        return result.stdout if binary else result.stdout.decode()

    # -- keys and requests --------------------------------------------------

    def generate_key(self, out):
        self.run(
            [
                "genpkey",
                "-algorithm",
                "RSA",
                "-pkeyopt",
                "rsa_keygen_bits:%d" % KEY_BITS,
                "-out",
                out,
            ]
        )
        os.chmod(out, stat.S_IRUSR | stat.S_IWUSR)

    def public_key(self, key_path):
        return self.run(["pkey", "-in", key_path, "-pubout"])

    def make_csr(self, key_path, config, out, digest):
        self.run(
            [
                "req",
                "-new",
                "-key",
                key_path,
                "-config",
                config,
                "-" + digest,
                "-outform",
                "DER",
                "-out",
                out,
            ]
        )

    def make_self_signed(self, key_path, config, out, digest):
        # Short-lived and never trusted by anything: it exists only to sign the
        # request and to address the CA's reply back to us.
        self.run(
            [
                "req",
                "-x509",
                "-key",
                key_path,
                "-config",
                config,
                "-" + digest,
                "-days",
                "1",
                "-set_serial",
                "1",
                "-outform",
                "DER",
                "-out",
                out,
            ]
        )

    def sign(self, key_path, data, digest):
        return self.run(["dgst", "-" + digest, "-sign", key_path], stdin=data)

    # -- CMS ----------------------------------------------------------------

    def encrypt(self, recipient_pem, data):
        """CMS EnvelopedData, AES-128-CBC, addressed to `recipient_pem`."""
        return self.run(
            [
                "cms",
                "-encrypt",
                "-binary",
                "-aes-128-cbc",
                "-outform",
                "DER",
                recipient_pem,
            ],
            stdin=data,
        )

    def unwrap_signed(self, data):
        """Check a SignedData's signature and return its encapsulated content.

        -noverify skips building a chain for the CA's own signing certificate,
        which we have no trust anchor for; the signature itself is still
        checked, and the certificate we ultimately keep is the one whose public
        key matches the key we generated.
        """
        return self.run(["cms", "-verify", "-noverify", "-inform", "DER"], stdin=data)

    def decrypt(self, key_path, cert_path, data):
        """Open a CMS EnvelopedData addressed to us."""
        return self.run(
            [
                "cms",
                "-decrypt",
                "-inform",
                "DER",
                "-inkey",
                key_path,
                "-recip",
                cert_path,
            ],
            stdin=data,
            legacy=True,
        )

    # -- certificates -------------------------------------------------------

    def der_to_pem(self, der):
        return self.run(["x509", "-inform", "DER"], stdin=der, binary=False)

    def pkcs7_certs(self, der):
        """The certificates inside a degenerate certs-only PKCS#7, as PEM."""
        return self.run(
            ["pkcs7", "-inform", "DER", "-print_certs"], stdin=der, binary=False
        )

    def cert_public_key(self, pem):
        return self.run(["x509", "-pubkey", "-noout"], stdin=pem.encode())


def conf_escape(value):
    """Escape a value for an openssl config file, where $ starts a variable."""
    return value.replace("\\", "\\\\").replace("$", "\\$").replace('"', '\\"')


def write_req_config(path, identity, challenge, device_id):
    with open(path, "w") as handle:
        handle.write(
            """[req]
distinguished_name = dn
req_extensions = v3_req
attributes = req_attr
prompt = no

[dn]
CN = %s
OU = Mist

[req_attr]
challengePassword = %s

[v3_req]
subjectAltName = DNS:%s
"""
            % (conf_escape(identity), conf_escape(challenge), conf_escape(device_id))
        )


def split_pem(text):
    """Every PEM certificate block in `text`, as separate strings."""
    blocks, current = [], []
    for line in text.splitlines():
        if line.startswith("-----BEGIN CERTIFICATE"):
            current = [line]
        elif current:
            current.append(line)
            if line.startswith("-----END CERTIFICATE"):
                blocks.append("\n".join(current) + "\n")
                current = []
    return blocks


def _read(path):
    with open(path, "rb") as handle:
        return handle.read()


# ---------------------------------------------------------------------------
# CMS SignedData
#
# The SignerInfo names its signing certificate by issuer and serial, so we
# pull those two fields out of the certificate openssl just made for us.
# ---------------------------------------------------------------------------


def issuer_and_serial(cert_der):
    node, _ = parse_one(cert_der)
    fields = node.children()[0].children()
    index = 1 if fields[0].tag == 0xA0 else 0  # skip [0] EXPLICIT version
    return der_seq(fields[index + 2].raw, der_int(read_int(fields[index])))


def attribute(oid, value):
    return der_seq(der_oid(oid), der_set(value))


def build_pki_message(openssl, key_path, signer_der, content, attributes, digest):
    """A SCEP pkiMessage: CMS SignedData carrying SCEP's signed attributes.

    This is the one structure openssl cannot build for us, because its CLI has
    no option for arbitrary authenticated attributes.
    """
    digest_oid = DIGEST_OIDS[digest]
    signed_attrs = [
        attribute(OID_CONTENT_TYPE, der_oid(OID_PKCS7_DATA)),
        attribute(
            OID_MESSAGE_DIGEST, der_octets(hashlib.new(digest, content).digest())
        ),
    ] + attributes
    signed_attrs.sort()  # DER requires SET OF members in sorted encoding order

    signature = openssl.sign(key_path, der_set(*signed_attrs), digest)

    signer_info = der_seq(
        der_int(1),
        issuer_and_serial(signer_der),
        algid(digest_oid),
        der_tagged(0, b"".join(signed_attrs)),
        algid(OID_RSA),
        der_octets(signature),
    )
    signed_data = der_seq(
        der_int(1),
        der_set(algid(digest_oid)),
        der_seq(der_oid(OID_PKCS7_DATA), der_tagged(0, der_octets(content))),
        der_tagged(0, signer_der),
        der_set(signer_info),
    )
    return der_seq(der_oid(OID_PKCS7_SIGNED), der_tagged(0, signed_data))


def read_signed_attributes(der):
    """The signed attributes of a CMS SignedData's first signer, keyed by OID.

    The input is whatever the server sent, so every structural assumption here
    can fail; report that as a plain error rather than a parser traceback.
    """
    try:
        node, _ = parse_one(der)
        content_type, wrapper = node.children()
        if read_oid(content_type) != OID_PKCS7_SIGNED:
            raise ScepError("the SCEP server did not return a signedData message")
        signers = wrapper.children()[0].children()[-1].children()  # signerInfos
        if not signers:
            raise ScepError("the SCEP reply contained no signer information")
        attributes = {}
        for part in signers[0].children():
            if part.tag == 0xA0:  # [0] IMPLICIT signedAttrs
                for attr in part.children():
                    oid_node, values = attr.children()
                    children = values.children()
                    attributes[read_oid(oid_node)] = (
                        children[0].body if children else None
                    )
        return attributes
    except (ValueError, IndexError) as exc:
        raise ScepError("could not parse the SCEP server's reply: %s" % exc) from exc


# ---------------------------------------------------------------------------
# SCEP
# ---------------------------------------------------------------------------


class ScepClient:
    def __init__(self, url, timeout=30):
        self.url = url.rstrip("/")
        self.timeout = timeout

    def _request(self, request):
        try:
            with urllib.request.urlopen(request, timeout=self.timeout) as response:
                return response.read(), response.headers.get("Content-Type", "")
        except urllib.error.HTTPError as exc:
            raise ScepError(
                "SCEP server returned HTTP %s %s" % (exc.code, exc.reason)
            ) from exc
        except OSError as exc:
            raise ScepError("could not reach the SCEP server: %s" % exc) from exc

    def get(self, operation):
        url = "%s?%s" % (self.url, urllib.parse.urlencode({"operation": operation}))
        return self._request(urllib.request.Request(url, method="GET"))

    def capabilities(self):
        body, _ = self.get("GetCACaps")
        return set(body.decode("ascii", "replace").split())

    def ca_certs(self, openssl):
        """GetCACert, as a list of PEM certificates."""
        body, content_type = self.get("GetCACert")
        if "ca-ra-cert" in content_type or _is_pkcs7(body):
            return split_pem(openssl.pkcs7_certs(body))
        return [openssl.der_to_pem(body)]

    def pki_operation(self, message):
        request = urllib.request.Request(
            "%s?operation=PKIOperation" % self.url,
            data=message,
            method="POST",
            headers={"Content-Type": "application/x-pki-message"},
        )
        return self._request(request)[0]


def _is_pkcs7(der):
    try:
        node, _ = parse_one(der)
        return read_oid(node.children()[0]) == OID_PKCS7_SIGNED
    except (ValueError, IndexError):
        return False


def negotiate(caps):
    """Choose the signature digest from the server's GetCACaps.

    RFC 8894 s3.5.2: "SCEPStandard" is shorthand for the mandatory-to-implement
    set -- AES, POSTPKIOperation and SHA-256 -- so a server advertising it
    supports AES without listing it separately. Mist advertises exactly that,
    plus SHA-512.
    """
    if not caps & {"SCEPStandard", "AES"}:
        raise ScepError(
            "the SCEP server does not advertise AES support (GetCACaps returned: "
            "%s); only AES-CBC is supported here"
            % (", ".join(sorted(caps)) or "nothing")
        )
    return "sha512" if "SHA-512" in caps else "sha256"


def pick_recipient(certs):
    """The certificate to encrypt the request to.

    Mist's GetCACert returns exactly one CA certificate. SCEP allows a separate
    RA certificate alongside it, which would need choosing between; if that ever
    starts happening we want to hear about it rather than guess.
    """
    if len(certs) != 1:
        raise ScepError(
            "expected one certificate from GetCACert, got %d -- this needs "
            "handling in mist-enroll" % len(certs)
        )
    return certs[0]


def enroll_scep(openssl, scep_url, identity, challenge, device_id, log=print):
    """Run a SCEP PKCSReq. Returns (private key PEM, issued certificate PEM)."""
    client = ScepClient(scep_url)

    log("Querying SCEP server capabilities...")
    digest = negotiate(client.capabilities())
    log("  signing with %s, encrypting with AES-128-CBC" % digest.upper())

    log("Fetching the SCEP CA certificate...")
    recipient_pem = openssl.path("recipient.pem")
    with open(recipient_pem, "w") as handle:
        handle.write(pick_recipient(client.ca_certs(openssl)))

    log("Generating a %d-bit RSA key..." % KEY_BITS)
    key_path = openssl.path("private.pem")
    openssl.generate_key(key_path)

    config = openssl.path("req.cnf")
    write_req_config(config, identity, challenge, device_id)
    csr_path = openssl.path("request.der")
    openssl.make_csr(key_path, config, csr_path, digest)

    # SCEP signs the request with a throwaway self-signed certificate, because
    # we have no issued one yet; the CA encrypts its reply back to it.
    signer_path = openssl.path("signer.der")
    openssl.make_self_signed(key_path, config, signer_path, digest)
    signer_pem = openssl.path("signer.pem")
    with open(signer_pem, "w") as handle:
        handle.write(openssl.der_to_pem(_read(signer_path)))

    trans_id = hashlib.sha256(openssl.public_key(key_path)).hexdigest()
    nonce = os.urandom(16)

    log("Submitting the certificate request...")
    envelope = openssl.encrypt(recipient_pem, _read(csr_path))
    message = build_pki_message(
        openssl,
        key_path,
        _read(signer_path),
        envelope,
        [
            attribute(OID_SCEP_TRANS_ID, der_printable(trans_id)),
            attribute(OID_SCEP_MESSAGE_TYPE, der_printable("19")),
            attribute(OID_SCEP_SENDER_NONCE, der_octets(nonce)),
        ],
        digest,
    )
    reply = client.pki_operation(message)

    attributes = read_signed_attributes(reply)
    check_status(attributes)
    echoed = attributes.get(OID_SCEP_RECIPIENT_NONCE)
    if echoed is not None and echoed != nonce:
        raise ScepError("the SCEP reply echoed the wrong nonce (possible tampering)")

    log("Decrypting the issued certificate...")
    inner = openssl.unwrap_signed(reply)
    if not inner:
        raise ScepError("the SCEP reply contained no certificate payload")
    degenerate = openssl.decrypt(key_path, signer_pem, inner)

    ours = openssl.public_key(key_path)
    for cert in split_pem(openssl.pkcs7_certs(degenerate)):
        if openssl.cert_public_key(cert) == ours:
            return _read(key_path).decode(), cert
    raise ScepError("the reply did not contain a certificate for our key")


def check_status(attributes):
    raw = attributes.get(OID_SCEP_PKI_STATUS)
    status = None if raw is None else raw.decode("ascii", "replace")
    if status == "0":
        return
    if status == "2":
        raw_fail = attributes.get(OID_SCEP_FAIL_INFO)
        fail = None if raw_fail is None else raw_fail.decode("ascii", "replace")
        raise ScepError(
            "the SCEP server rejected the request: %s"
            % FAIL_INFO.get(fail, "failInfo=%s" % fail)
        )
    if status == "3":
        raise ScepError(
            "the SCEP server put the request into manual approval (PENDING). "
            "Mist normally issues immediately, so the enrollment challenge has "
            "most likely already been used -- get a fresh URL."
        )
    raise ScepError("unexpected pkiStatus %r from the SCEP server" % status)


# ---------------------------------------------------------------------------
# Mist enrollment endpoint
# ---------------------------------------------------------------------------


def fetch_enrollment(url, device_id, timeout=30):
    if url.startswith("marvisclient://"):
        url = "https://" + url[len("marvisclient://") :]
    if not url.startswith("https://"):
        raise ScepError(
            "the enrollment URL must be https:// or marvisclient://\n\n"
            + HOW_TO_GET_URL
        )
    request = urllib.request.Request(
        url,
        data=json.dumps({"device_id": device_id}).encode(),
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            payload = json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        raise ScepError(
            "the enrollment endpoint returned HTTP %s %s -- the URL has most "
            "likely expired.\n\n%s" % (exc.code, exc.reason, HOW_TO_GET_URL)
        ) from exc
    except OSError as exc:
        raise ScepError("could not reach the enrollment endpoint: %s" % exc) from exc
    except ValueError as exc:  # JSONDecodeError, UnicodeDecodeError
        raise ScepError("the enrollment endpoint did not return JSON") from exc

    nac = payload.get("nac") or {}
    missing = [
        k
        for k in ("identity", "scep_url", "scep_enrollment_challenge")
        if not nac.get(k)
    ]
    if missing:
        raise ScepError("enrollment response is missing: %s" % ", ".join(missing))
    return nac


def server_ca_pem(nac):
    """The CA certificate to pin in the profiles."""
    server_cert = nac.get("nac_server_cert")
    if server_cert:
        return server_cert if server_cert.endswith("\n") else server_cert + "\n"
    cacerts = nac.get("cacerts") or []
    if not cacerts:
        raise ScepError(
            "Mist returned no server certificate to pin; cannot build a profile"
        )
    return "\n".join(c.rstrip("\n") for c in cacerts) + "\n"


# ---------------------------------------------------------------------------
# NetworkManager profiles
# ---------------------------------------------------------------------------


def data_blob(text):
    return "data:;base64," + b64encode(text.encode("utf-8")).decode("ascii")


def eap_section(identity, client_pem, key_pem, ca_pem):
    return """[802-1x]
eap=tls
identity={identity}
client-cert={client}
private-key={key}
private-key-password-flags=4
ca-cert={ca}
system-ca-certs=false
""".format(
        identity=identity,
        client=data_blob(client_pem),
        key=data_blob(key_pem),
        ca=data_blob(ca_pem),
    )


def wifi_profile(identity, client_pem, key_pem, ca_pem):
    return (
        PROFILE_HEADER % identity
        + """[connection]
id={id}
uuid={uuid}
type=wifi
autoconnect=true

[wifi]
mode=infrastructure
ssid={ssid}

[wifi-security]
key-mgmt=wpa-eap
pmf=2

{eap}
[ipv4]
method=auto

[ipv6]
method=auto
""".format(
            id=WIFI_ID,
            uuid=uuid.uuid4(),
            ssid=SSID,
            eap=eap_section(identity, client_pem, key_pem, ca_pem),
        )
    )


def wired_profile(identity, client_pem, key_pem, ca_pem):
    return (
        PROFILE_HEADER % identity
        + """[connection]
id={id}
uuid={uuid}
type=802-3-ethernet
autoconnect=true
autoconnect-priority={priority}

[802-3-ethernet]

{eap}
[ipv4]
method=auto

[ipv6]
method=auto
""".format(
            id=WIRED_ID,
            uuid=uuid.uuid4(),
            priority=WIRED_PRIORITY,
            eap=eap_section(identity, client_pem, key_pem, ca_pem),
        )
    )


def write_profile(path, content):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as handle:
        handle.write(content)
    os.chmod(path, stat.S_IRUSR | stat.S_IWUSR)
    return path


