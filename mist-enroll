def make_workdir():
    """A private scratch directory, in RAM where the system offers one.

    openssl needs the private key on the filesystem, so prefer /dev/shm (tmpfs,
    never written to disk) over /tmp, which on most systems is disk-backed and
    where deletion would not erase the contents. Created mode 0700 either way.
    """
    shm = "/dev/shm"
    if os.path.isdir(shm) and os.access(shm, os.W_OK):
        return tempfile.mkdtemp(prefix="mist-enroll-", dir=shm)
    return tempfile.mkdtemp(prefix="mist-enroll-")


def main(argv=None):
    argv = sys.argv[1:] if argv is None else list(argv)
    if argv and argv[0] in ("-h", "--help"):
        print("%s\n\n%s" % (__doc__.strip(), HOW_TO_GET_URL))
        return 0
    if len(argv) > 1 or (argv and argv[0].startswith("-")):
        print("usage: mist-enroll [ENROLLMENT_URL]", file=sys.stderr)
        return 2

    url = argv[0].strip() if argv else None
    if not url:
        print(HOW_TO_GET_URL)
        try:
            url = input("Enter the Mist enrollment URL: ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return 130
    if not url:
        print("No enrollment URL given.", file=sys.stderr)
        return 2

    device_id = str(uuid.uuid4())
    workdir = make_workdir()
    try:
        openssl = OpenSSL(workdir)

        print("Contacting the Mist enrollment endpoint...")
        nac = fetch_enrollment(url, device_id)
        identity = nac["identity"]
        print("  identity: %s" % identity)

        key_pem, client_pem = enroll_scep(
            openssl,
            nac["scep_url"],
            identity,
            nac["scep_enrollment_challenge"],
            device_id,
        )
        ca_pem = server_ca_pem(nac)

        try:
            written = [
                write_profile(
                    "%s.nmconnection" % WIFI_ID,
                    wifi_profile(identity, client_pem, key_pem, ca_pem),
                ),
                write_profile(
                    "%s.nmconnection" % WIRED_ID,
                    wired_profile(identity, client_pem, key_pem, ca_pem),
                ),
            ]
        except OSError as exc:
            raise ScepError(
                "the certificate was issued, but writing the profiles into %s "
                "failed: %s.\nRun mist-enroll from a writable directory. The "
                "enrollment URL has been used and will need replacing."
                % (os.getcwd(), exc)
            ) from exc

        print("\nSuccess. Wrote:")
        for path in written:
            print("  %s" % path)

        print("\n%s" % SECRET_WARNING)
        print("\nTo install them, run:")
        for path in written:
            print(
                "  sudo install -o root -g root -m 600 %s %s/"
                % (os.path.basename(path), PROFILE_DIR)
            )
        print("  sudo nmcli connection reload")
        print("\nThen delete the copies left here:")
        print("  shred -u %s" % " ".join(os.path.basename(p) for p in written))
        return 0

    except ScepError as exc:
        sys.stdout.flush()  # keep stderr from jumping ahead of progress output
        print("\nError: %s" % exc, file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("\nAborted.", file=sys.stderr)
        return 130
    except Exception:
        sys.stdout.flush()
        print(
            "\nUnexpected error -- traceback follows. If this happened after "
            "the request was submitted, the enrollment URL has been used and "
            "you will need a fresh one.\n",
            file=sys.stderr,
        )
        raise
    finally:
        shutil.rmtree(workdir, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main())
